{
  "name": "liquid-graph",
  "version": "0.1.0",
  "description": "Spring-driven particle graphs with fluid transitions and pointer interaction.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./chartjs": {
      "import": {
        "types": "./dist/chartjs.d.ts",
        "default": "./dist/chartjs.js"
      },
      "require": {
        "types": "./dist/chartjs.d.cts",
        "default": "./dist/chartjs.cjs"
      }
    },
    "./tanstack": {
      "import": {
        "types": "./dist/tanstack.d.ts",
        "default": "./dist/tanstack.js"
      },
      "require": {
        "types": "./dist/tanstack.d.cts",
        "default": "./dist/tanstack.cjs"
      }
    },
    "./recharts": {
      "import": {
        "types": "./dist/recharts.d.ts",
        "default": "./dist/recharts.js"
      },
      "require": {
        "types": "./dist/recharts.d.cts",
        "default": "./dist/recharts.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite demo --config vite.config.ts --host 127.0.0.1",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo:build": "vite build demo --config vite.config.ts --outDir ../demo-dist --emptyOutDir",
    "check": "npm run typecheck && npm test && npm run build && npm run demo:build",
    "prepack": "npm run build"
  },
  "keywords": [
    "particles",
    "chart",
    "graph",
    "canvas",
    "animation",
    "typescript",
    "chart.js",
    "chartjs-plugin",
    "tanstack",
    "recharts"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "chart.js": "^4.6.1"
  },
  "peerDependencies": {
    "chart.js": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "chart.js": {
      "optional": true
    }
  }
}
